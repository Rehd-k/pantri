<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- NestJS is served over HTTP in local/dev. Android 9+ blocks that unless permitted. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
